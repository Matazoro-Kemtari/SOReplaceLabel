<metro:MetroWindow x:Class="SOReplaceLabel.Views.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prism="http://prismlibrary.com/"             
                    prism:ViewModelLocator.AutoWireViewModel="True"
                    xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    WindowState="Maximized"
                    TitleCharacterCasing="Normal"
                    WindowTitleBrush="{DynamicResource MahApps.Brushes.Accent}"
                    NonActiveWindowTitleBrush="{DynamicResource MahApps.Brushes.Accent3}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                    BorderThickness="1"
                    Title="{Binding Title}" Height="768" Width="1024">
    <metro:MetroWindow.IconTemplate>
        <DataTemplate>
            <iconPacks:PackIconMaterialDesign Kind="ReceiptLong" 
                                              Width="25" 
                                              Height="25"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="4"
                                              Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
        </DataTemplate>
    </metro:MetroWindow.IconTemplate>

    <Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</metro:MetroWindow>
